// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  schemas  = ["finsync"]
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum SystemRole {
  Owner
  Cashier
  Sales
  Storekeeper
  OperatorDriver
  ProjectManager
  Foreman

  @@schema("finsync")
}

enum BudgetType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@schema("finsync")
}

enum StoreTxType {
  ISSUE
  RESTOCK
  RETURN

  @@schema("finsync")
}

enum CompanyType {
  CONSTRUCTION
  RETAIL
  LOGISTICS
  AGRICULTURE
  MANUFACTURING
  SERVICE
  OTHER

  @@schema("finsync")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@schema("finsync")
}

enum AccountNormalSide {
  DEBIT
  CREDIT

  @@schema("finsync")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("finsync")
}

// ==========================================
// 2. USERS & COMPANIES
// ==========================================

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  phone     String?
  role      SystemRole @default(Owner)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  ownedCompanies       Company[]          @relation("CompanyOwner")
  companyMemberships   CompanyMember[]
  personalExpenses     PersonalExpense[]
  personalBudgets      PersonalBudget[]
  personalSavings      PersonalSaving[]
  registeredIncomes    CompanyIncome[]
  registeredExpenses   CompanyExpense[]
  storeTransactions    StoreTransaction[]
  projectUpdates       ProjectUpdate[]
  notifications        Notification[]
  storeRequests        StoreRequest[]
  personalAccounts     PersonalAccount[]
  accountTransfers     AccountTransfer[]
  personalIncomes      PersonalIncome[]
  registeredSales      Sale[]
  registeredPurchases  Purchase[]
  postedJournalEntries JournalEntry[]

  employee        Employee?
  storeIssuedBy   StoreTransaction[] @relation("StoreIssuedBy")
  requestIssuedBy StoreRequest[]     @relation("RequestIssuedBy")

  @@schema("finsync")
}

model PersonalAccount {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      PersonalExpense[]
  incomes       PersonalIncome[]
  transfersFrom AccountTransfer[] @relation("FromAccount")
  transfersTo   AccountTransfer[] @relation("ToAccount")

  @@schema("finsync")
}

model Company {
  id        Int         @id @default(autoincrement())
  name      String
  industry  String?
  type      CompanyType @default(OTHER)
  currency  String      @default("USD")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Temporary worker settings (DailyLaborers registry)
  tempWorkerTimeMode   String    @default("TIMESHEET") @map("temp_worker_time_mode") // ATTENDANCE | TIMESHEET
  tempWorkerTaxEnabled Boolean   @default(false) @map("temp_worker_tax_enabled")
  tempWorkerTaxRate    Decimal?  @db.Decimal(5, 2) @map("temp_worker_tax_rate") // default % for temp workers

  ownerId                Int                           @map("owner_id")
  owner                  User                          @relation("CompanyOwner", fields: [ownerId], references: [id])
  members                CompanyMember[]
  incomes                CompanyIncome[]
  expenses               CompanyExpense[]
  employees              Employee[]
  machineries            Machinery[]
  storeItems             StoreItem[]
  projects               Project[]
  storeTransactions      StoreTransaction[]
  storeRequests          StoreRequest[]
  sales                  Sale[]
  purchases              Purchase[]
  customers              Customer[]
  suppliers              Supplier[]
  storeCategories        StoreCategory[]
  companyRoles           CompanyRole[]
  attendances            Attendance[]
  timesheets             Timesheet[]
  payrolls               Payroll[]
  accounts               Account[]
  journalEntries         JournalEntry[]
  leaveTypes             LeaveType[]
  leaveRequests          LeaveRequest[]
  taxTables              TaxTable[]
  payrollDeductions      PayrollDeduction[]
  depreciationMethods    DepreciationMethod[]
  overtimeRates          OvertimeRate[]
  payrollConfigVersions  CompanyPayrollConfigVersion[]
  dailyLaborers          DailyLaborer[]
  dailyLaborerTimesheets DailyLaborerTimesheet[]
  dailyLaborerAttendances DailyLaborerAttendance[]
  workPositions          WorkPosition[]

  @@schema("finsync")
}

model Permission {
  id          Int    @id @default(autoincrement())
  code        String @unique
  description String

  companyRoles CompanyRolePermission[]

  @@schema("finsync")
}

model CompanyRole {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  createdAt DateTime @default(now())

  company     Company                 @relation(fields: [companyId], references: [id])
  permissions CompanyRolePermission[]
  members     CompanyMember[]

  @@unique([name, companyId])
  @@schema("finsync")
}

model CompanyRolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@schema("finsync")
}

model CompanyMember {
  id            Int        @id @default(autoincrement())
  userId        Int        @map("user_id")
  companyId     Int        @map("company_id")
  role          SystemRole
  companyRoleId Int?       @map("company_role_id")

  user        User         @relation(fields: [userId], references: [id])
  company     Company      @relation(fields: [companyId], references: [id])
  companyRole CompanyRole? @relation(fields: [companyRoleId], references: [id])

  @@unique([userId, companyId])
  @@schema("finsync")
}

// ==========================================
// 3. PERSONAL FINANCE
// ==========================================

model PersonalBudget {
  id        Int        @id @default(autoincrement())
  userId    Int
  category  String
  amount    Float
  frequency BudgetType
  startDate DateTime   @default(now())
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model PersonalExpense {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  amount             Float
  category           String?
  note               String?
  date               DateTime @default(now())
  isCategorized      Boolean  @default(false)
  createdAt          DateTime @default(now())
  accountId          Int?
  isRecurring        Boolean  @default(false)
  recurringFrequency String?

  account PersonalAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user    User             @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model PersonalIncome {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float
  category  String
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  accountId Int?
  account   PersonalAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model PersonalSaving {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  name            String     @default("Savings Goal")
  targetAmount    Float      @map("target_amount")
  currentAmount   Float      @default(0) @map("current_amount")
  thresholdAmount Float      @map("threshold_amount")
  frequency       BudgetType
  startDate       DateTime   @map("start_date")
  createdAt       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model AccountTransfer {
  id            Int      @id @default(autoincrement())
  userId        Int
  fromAccountId Int
  toAccountId   Int
  amount        Float
  date          DateTime @default(now())
  note          String?

  fromAccount PersonalAccount @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   PersonalAccount @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("finsync")
}

// ==========================================
// 4. COMPANY FINANCE
// ==========================================

model CompanyIncome {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  registeredBy Int      @map("registered_by")
  amount       Float
  category     String
  date         DateTime @default(now())
  note         String?
  projectId    Int?     @map("project_id")
  machineryId  Int?     @map("machinery_id")
  createdAt    DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  user      User       @relation(fields: [registeredBy], references: [id])
  machinery Machinery? @relation(fields: [machineryId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])

  @@schema("finsync")
}

model CompanyExpense {
  id                 Int      @id @default(autoincrement())
  companyId          Int      @map("company_id")
  registeredBy       Int      @map("registered_by")
  amount             Float
  category           String
  date               DateTime @default(now())
  note               String?
  projectId          Int?     @map("project_id")
  machineryId        Int?     @map("machinery_id")
  createdAt          DateTime @default(now())
  isRecurring        Boolean  @default(false)
  recurringFrequency String?

  company         Company        @relation(fields: [companyId], references: [id])
  user            User           @relation(fields: [registeredBy], references: [id])
  machinery       Machinery?     @relation(fields: [machineryId], references: [id])
  project         Project?       @relation(fields: [projectId], references: [id])
  unit            String?
  measuringUnit   MeasuringUnit? @relation(fields: [measuringUnitId], references: [id])
  measuringUnitId Int?

  payroll Payroll?
  log     MachineryLog?
  maint   MachineryMaintenance?

  @@schema("finsync")
}

model MeasuringUnit {
  id   Int    @id @default(autoincrement())
  name String

  storeItems      StoreItem[]
  companyExpenses CompanyExpense[]

  @@schema("finsync")
}

// ==========================================
// 5. EMPLOYEES (HR)
// ==========================================

model Employee {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  employeeCode   String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  designation    String
  employmentType String        @default("FULL_TIME")
  payFrequency   String        @default("MONTHLY") // MONTHLY | WEEKLY | DAILY
  positionId     Int?          @map("position_id")
  position       WorkPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  baseSalary Decimal? @db.Decimal(12, 2)
  hourlyRate Decimal? @db.Decimal(10, 2)
  dailyRate  Decimal? @db.Decimal(10, 2)
  weeklyRate Decimal? @db.Decimal(10, 2)

  isActive   Boolean  @default(true)
  joinedDate DateTime @default(now())

  projectAssignments  ProjectMember[]
  attendanceLogs      Attendance[]
  timesheets          Timesheet[]
  payrollItems        PayrollItem[]
  operatedMachineries Machinery[]            @relation("MachineOperator")
  machineryLogs       MachineryLog[]
  maintenancesDone    MachineryMaintenance[]
  managedProjects     Project[]              @relation("ProjectManager")
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  reviewedLeaves      LeaveRequest[]         @relation("LeaveReviewer")

  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  overtimeEntries            OvertimeEntry[]
  employeeSpecificAllowances EmployeeSpecificAllowance[]
  payrollBonuses             PayrollBonus[]
  payrollWithholdings        PayrollWithholding[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@map("employees")
  @@schema("finsync")
}

// ==========================================
// 5a. WORK POSITIONS & POSITION-BASED ALLOWANCES
// ==========================================

model WorkPosition {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  allowances        PositionAllowance[]
  assignedEmployees Employee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("work_positions")
  @@schema("finsync")
}

model PositionAllowance {
  id         Int          @id @default(autoincrement())
  companyId  Int          @map("company_id")
  positionId Int          @map("position_id")
  position   WorkPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  name          String
  amount        Decimal   @db.Decimal(12, 2)
  isTaxable     Boolean   @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  taxConfig     Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([positionId])
  @@map("position_allowances")
  @@schema("finsync")
}

// ==========================================
// 5b. DAILY LABORERS (Dedicated Registry — separated from standard staff)
// ==========================================

model DailyLaborer {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  laborerCode String
  firstName   String
  lastName    String
  phone       String?
  dailyRate   Decimal  @db.Decimal(10, 2)
  hourlyRate  Decimal? @db.Decimal(10, 2) @map("hourly_rate")
  taxMethod   String   @default("GLOBAL") @map("tax_method") // GLOBAL | CUSTOM | EXEMPT
  taxRate     Decimal? @db.Decimal(5, 2) @map("tax_rate") // override rate when taxMethod = CUSTOM
  isActive    Boolean  @default(true)
  joinedDate  DateTime @default(now())

  timesheets DailyLaborerTimesheet[]
  attendances DailyLaborerAttendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, laborerCode])
  @@index([companyId])
  @@map("daily_laborers")
  @@schema("finsync")
}

model DailyLaborerTimesheet {
  id        Int          @id @default(autoincrement())
  companyId Int
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  laborerId Int
  laborer   DailyLaborer @relation(fields: [laborerId], references: [id], onDelete: Cascade)

  date     DateTime @db.Date
  hours    Decimal  @default(8) @db.Decimal(5, 2)
  breakDay Boolean  @default(false) // rest/break day — not payable
  note     String?
  status   String   @default("APPROVED") // APPROVED | PENDING

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([laborerId, date])
  @@index([companyId, date])
  @@map("daily_laborer_timesheets")
  @@schema("finsync")
}

// Attendance-mode records for temporary workers (when company uses ATTENDANCE mode).
// Half-day / late workers are weighted in payroll: PRESENT=1.0, LATE=1.0, HALF_DAY=0.5, ABSENT=0.
model DailyLaborerAttendance {
  id        Int          @id @default(autoincrement())
  companyId Int
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  laborerId Int
  laborer   DailyLaborer @relation(fields: [laborerId], references: [id], onDelete: Cascade)

  date   DateTime @db.Date
  status String   @default("PRESENT") // PRESENT | LATE | HALF_DAY | ABSENT
  note   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([laborerId, date])
  @@index([companyId, date])
  @@map("daily_laborer_attendances")
  @@schema("finsync")
}

// ==========================================
// 6. PROJECTS
// ==========================================

model Project {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  description String?  @db.Text
  status      String   @default("IN_PROGRESS")
  progress    Int      @default(0)
  budget      Decimal? @db.Decimal(12, 2)

  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?

  managerId Int?
  manager   Employee? @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  members         ProjectMember[]
  tasks           ProjectTask[]
  attendanceLogs  Attendance[]
  timesheets      Timesheet[]
  machineries     Machinery[]
  machineryLogs   MachineryLog[]
  companyIncomes  CompanyIncome[]
  companyExpenses CompanyExpense[]
  purchases       Purchase[]
  storeRequests   StoreRequest[]

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  projectUpdates    ProjectUpdate[]
  payrolls          Payroll[]
  journalEntries    JournalEntry[]
  storeTransactions StoreTransaction[]

  @@index([companyId])
  @@map("projects")
  @@schema("finsync")
}

model ProjectMember {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  roleOnSite String?
  customRate Decimal? @db.Decimal(10, 2)
  assignedAt DateTime @default(now())

  @@unique([projectId, employeeId])
  @@map("project_members")
  @@schema("finsync")
}

model ProjectTask {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?   @db.Text
  status      String    @default("TODO")
  dueDate     DateTime?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("project_tasks")
  @@schema("finsync")
}

model ProjectUpdate {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  userId      Int      @map("user_id")
  note        String
  newProgress Float    @map("new_progress")
  date        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

// ==========================================
// 7. ATTENDANCE & TIMESHEETS
// ==========================================

model Attendance {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  date     DateTime  @db.Date
  checkIn  DateTime?
  checkOut DateTime?
  status   String    @default("PRESENT")
  remarks  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@map("attendances")
  @@schema("finsync")
}

model Timesheet {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  machineryId Int?
  machinery   Machinery? @relation(fields: [machineryId], references: [id], onDelete: SetNull)

  date          DateTime @db.Date
  regularHours  Decimal  @default(8.0) @db.Decimal(4, 2)
  overtimeHours Decimal  @default(0.0) @db.Decimal(4, 2)
  description   String?  @db.Text
  status        String   @default("DRAFT")

  approvedById Int?
  approvedAt   DateTime?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, employeeId, date])
  @@map("timesheets")
  @@schema("finsync")
}

// ==========================================
// 8. PAYROLL
// ==========================================

model Payroll {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title       String
  sourceType  String   @default("ALL") // ATTENDANCE | TIMESHEETS | ALL
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  totalAmount Decimal  @default(0) @db.Decimal(12, 2)
  status      String   @default("DRAFT")

  items PayrollItem[]

  expenseId Int?            @unique
  expense   CompanyExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payrolls")
  @@schema("finsync")
}

model PayrollItem {
  id        Int     @id @default(autoincrement())
  payrollId Int
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  basePay          Decimal @db.Decimal(10, 2)
  overtimeEarnings Decimal @default(0) @db.Decimal(12, 2)
  overtimePay      Decimal @default(0) @db.Decimal(10, 2)
  allowanceTotal   Decimal @default(0) @db.Decimal(12, 2)
  bonusTotal       Decimal @default(0) @db.Decimal(12, 2)
  grossPay         Decimal @db.Decimal(10, 2)
  totalDeductions  Decimal @default(0) @db.Decimal(10, 2)
  withholdingTotal Decimal @default(0) @db.Decimal(12, 2)
  netPay           Decimal @db.Decimal(10, 2)

  unpaidLeaveDays      Float   @default(0)
  unpaidLeaveDeduction Decimal @default(0) @db.Decimal(10, 2)
  taxAmount            Decimal @default(0) @db.Decimal(10, 2)

  deductionBreakdown         PayrollItemDeduction[]
  overtimeEntries            OvertimeEntry[]
  employeeSpecificAllowances EmployeeSpecificAllowance[]
  bonuses                    PayrollBonus[]
  withholdings               PayrollWithholding[]

  @@map("payroll_items")
  @@schema("finsync")
}

// 8c. OVERTIME
model OvertimeRate {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String // "Weekday OT", "Weekend OT", "Holiday OT"
  multiplier Decimal @db.Decimal(4, 2) // 1.5, 2.0, 3.0
  isActive   Boolean @default(true)

  entries OvertimeEntry[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@map("overtime_rates")
  @@schema("finsync")
}

model OvertimeEntry {
  id             Int           @id @default(autoincrement())
  companyId      Int           @map("company_id")
  employeeId     Int           @map("employee_id")
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  overtimeRateId Int?          @map("overtime_rate_id")
  overtimeRate   OvertimeRate? @relation(fields: [overtimeRateId], references: [id], onDelete: SetNull)

  date       DateTime @db.Date
  hours      Decimal  @db.Decimal(6, 2)
  hourlyRate Decimal  @db.Decimal(10, 2) // captured at entry time
  multiplier Decimal  @db.Decimal(4, 2) // captured at entry time
  amount     Decimal  @db.Decimal(12, 2) // hours × hourlyRate × multiplier
  status     String   @default("DRAFT") // DRAFT | APPROVED
  reason     String?  @db.Text

  payrollItemId Int?
  payrollItem   PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)
  createdById   Int?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([companyId, date])
  @@index([employeeId, status])
  @@map("overtime_entries")
  @@schema("finsync")
}

// 8d. PAYROLL COMPENSATION
// Employee-specific allowances — assigned to ONE employee directly.
// Contrast with PositionAllowance (auto-applied to all employees in a work position).
model EmployeeSpecificAllowance {
  id            Int          @id @default(autoincrement())
  companyId     Int          @map("company_id")
  employeeId    Int          @map("employee_id")
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollItemId Int?         @map("payroll_item_id")
  payrollItem   PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  name          String // free-text allowance name, e.g. "Site Hazard Pay"
  amount        Decimal   @db.Decimal(12, 2)
  isTaxable     Boolean   @default(true)
  reason        String?   @db.Text
  effectiveDate DateTime  @db.Date
  expiryDate    DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([employeeId])
  @@map("employee_specific_allowances")
  @@schema("finsync")
}

model PayrollBonus {
  id            Int          @id @default(autoincrement())
  companyId     Int          @map("company_id")
  employeeId    Int          @map("employee_id")
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollItemId Int?         @map("payroll_item_id")
  payrollItem   PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  type          String // PERFORMANCE | 13TH_MONTH
  amount        Decimal   @db.Decimal(12, 2)
  reason        String?   @db.Text
  effectiveDate DateTime  @db.Date
  expiryDate    DateTime?
  isActive      Boolean   @default(true)

  @@map("payroll_bonuses")
  @@schema("finsync")
}

model PayrollWithholding {
  id            Int          @id @default(autoincrement())
  companyId     Int          @map("company_id")
  employeeId    Int?         @map("employee_id")
  employee      Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollItemId Int?         @map("payroll_item_id")
  payrollItem   PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  name          String    @default("Withholding") // Custom free-text label e.g. "Union Dues"
  type          String // LOAN | INSURANCE | ADVANCE | FINE | OTHER
  calcType      String    @default("FIXED") // FIXED | PERCENTAGE
  amount        Decimal   @db.Decimal(12, 2) // fixed amount OR percentage value when calcType=PERCENTAGE
  isGlobal      Boolean   @default(false) // true = applies to ALL employees in payroll run
  reason        String    @db.Text // REQUIRED custom reason
  effectiveDate DateTime  @db.Date
  expiryDate    DateTime?
  isActive      Boolean   @default(true)

  @@map("payroll_withholdings")
  @@schema("finsync")
}

// ==========================================
// 8b. TAX & DEDUCTIONS
// ==========================================

model TaxTable {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean @default(true)

  brackets TaxBracket[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@map("tax_tables")
  @@schema("finsync")
}

model TaxBracket {
  id         Int      @id @default(autoincrement())
  taxTableId Int      @map("tax_table_id")
  taxTable   TaxTable @relation(fields: [taxTableId], references: [id], onDelete: Cascade)

  minIncome   Decimal  @db.Decimal(12, 2)
  maxIncome   Decimal? @db.Decimal(12, 2)
  rate        Decimal  @db.Decimal(5, 2)
  fixedAmount Decimal  @default(0) @db.Decimal(10, 2)

  @@map("tax_brackets")
  @@schema("finsync")
}

model PayrollDeduction {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  type     String  @default("FIXED") // FIXED | PERCENTAGE | BRACKET | LEAVE_UNPAID
  value    Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@index([companyId, type])
  @@map("payroll_deductions")
  @@schema("finsync")
}

model PayrollItemDeduction {
  id            Int         @id @default(autoincrement())
  payrollItemId Int         @map("payroll_item_id")
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  name   String
  amount Decimal @db.Decimal(10, 2)
  type   String // FIXED | PERCENTAGE | BRACKET | LEAVE_UNPAID

  @@map("payroll_item_deductions")
  @@schema("finsync")
}

// ==========================================
// 9. MACHINERY & FLEET
// ==========================================

model Machinery {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name   String
  code   String?
  type   String  @default("OTHER")
  status String  @default("AVAILABLE")

  make         String?
  model        String?
  plateNumber  String?
  serialNumber String?

  totalHoursRun  Decimal @default(0) @db.Decimal(10, 2)
  currentMileage Decimal @default(0) @db.Decimal(10, 2)

  hourlyRate Decimal? @db.Decimal(10, 2)
  dailyRate  Decimal? @db.Decimal(10, 2)

  operatorId Int?
  operator   Employee? @relation("MachineOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  purchaseDate        DateTime?           @map("purchase_date")
  purchaseCost        Decimal?            @map("purchase_cost") @db.Decimal(12, 2)
  residualValue       Decimal?            @map("residual_value") @db.Decimal(12, 2)
  usefulLifeYears     Int?                @map("useful_life_years")
  depreciationEnabled Boolean             @default(false) @map("depreciation_enabled")
  depMethodId         Int?                @map("dep_method_id")
  depMethod           DepreciationMethod? @relation("MachineryDepMethod", fields: [depMethodId], references: [id], onDelete: SetNull)

  incomes               CompanyIncome[]
  expenses              CompanyExpense[]
  timesheets            Timesheet[]
  logs                  MachineryLog[]
  maintenances          MachineryMaintenance[]
  depreciationSchedules DepreciationSchedule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("machineries")
  @@schema("finsync")
}

model DepreciationMethod {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name                   String // "Straight-Line", "Declining Balance"
  type                   String  @default("STRAIGHT_LINE") // STRAIGHT_LINE | DECLINING_BALANCE
  defaultRate            Decimal @db.Decimal(5, 2) // e.g. 20.00 = 20%
  defaultUsefulLifeYears Int     @default(5)
  isActive               Boolean @default(true)

  machineries Machinery[] @relation("MachineryDepMethod")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@map("depreciation_methods")
  @@schema("finsync")
}

model DepreciationSchedule {
  id          Int       @id @default(autoincrement())
  machineryId Int       @map("machinery_id")
  machinery   Machinery @relation(fields: [machineryId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  depreciationAmount      Decimal @db.Decimal(12, 2)
  accumulatedDepreciation Decimal @db.Decimal(12, 2) // running total
  netBookValue            Decimal @db.Decimal(12, 2) // purchaseCost - accumulatedDepreciation
  status                  String  @default("PLANNED") // PLANNED | POSTED

  journalEntryId Int?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([machineryId, startDate, endDate])
  @@index([machineryId])
  @@map("depreciation_schedules")
  @@schema("finsync")
}

model MachineryLog {
  id          Int       @id @default(autoincrement())
  machineryId Int
  machinery   Machinery @relation(fields: [machineryId], references: [id], onDelete: Cascade)

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  operatorId Int?
  operator   Employee? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  startMeter  Decimal? @db.Decimal(10, 2)
  endMeter    Decimal? @db.Decimal(10, 2)
  hoursLogged Decimal  @default(0) @db.Decimal(8, 2)

  fuelLiters Decimal? @db.Decimal(8, 2)
  fuelCost   Decimal? @db.Decimal(10, 2)

  expenseId Int?            @unique
  expense   CompanyExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("machinery_logs")
  @@schema("finsync")
}

model MachineryMaintenance {
  id          Int       @id @default(autoincrement())
  machineryId Int
  machinery   Machinery @relation(fields: [machineryId], references: [id], onDelete: Cascade)

  description String  @db.Text
  totalCost   Decimal @db.Decimal(10, 2)

  performedById Int?
  performedBy   Employee? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  expenseId Int?            @unique
  expense   CompanyExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("machinery_maintenances")
  @@schema("finsync")
}

// ==========================================
// 10. STORE & INVENTORY
// ==========================================

model StoreCategory {
  id        Int      @id @default(autoincrement())
  name      String
  companyId Int      @map("company_id")
  createdAt DateTime @default(now())

  company Company     @relation(fields: [companyId], references: [id])
  items   StoreItem[]

  @@unique([name, companyId])
  @@schema("finsync")
}

model StoreItem {
  id                Int      @id @default(autoincrement())
  companyId         Int      @map("company_id")
  name              String
  categoryId        Int      @map("category_id")
  quantity          Float    @default(0)
  reservedQuantity  Float    @default(0) @map("reserved_quantity")
  lowStockThreshold Float    @default(5) @map("low_stock_threshold")
  sellingPrice      Float    @default(0) @map("selling_price")
  costPrice         Float    @default(0) @map("cost_price")
  isTool            Boolean  @default(false) @map("is_tool")
  createdAt         DateTime @default(now())
  unit              String   @default("pcs")

  company         Company            @relation(fields: [companyId], references: [id])
  category        StoreCategory      @relation(fields: [categoryId], references: [id])
  transactions    StoreTransaction[]
  storeRequests   StoreRequest[]
  measuringUnit   MeasuringUnit?     @relation(fields: [measuringUnitId], references: [id])
  measuringUnitId Int?
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]

  @@schema("finsync")
}

model StoreTransaction {
  id             Int         @id @default(autoincrement())
  itemId         Int         @map("item_id")
  companyId      Int         @map("company_id")
  type           StoreTxType
  quantity       Float
  issuedToUserId Int?        @map("issued_to_user_id")
  date           DateTime    @default(now())
  status         String      @default("APPROVED")
  note           String?
  createdAt      DateTime    @default(now())

  ledgerEntryId Int?     @map("ledger_entry_id")
  unitCost      Float?
  totalCost     Float?   @map("total_cost")
  projectId     Int?     @map("project_id")
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issuedById    Int?     @map("issued_by_id")
  issuedBy      User?    @relation("StoreIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  item    StoreItem @relation(fields: [itemId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])
  user    User?     @relation(fields: [issuedToUserId], references: [id])

  @@index([companyId, date])
  @@index([itemId])
  @@index([projectId])
  @@schema("finsync")
}

model StoreRequest {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  companyId Int      @map("company_id")
  userId    Int      @map("user_id")
  quantity  Float
  status    String   @default("PENDING")
  note      String?
  createdAt DateTime @default(now())

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  issuedQuantity Float     @default(0) @map("issued_quantity")
  issuedById     Int?      @map("issued_by_id")
  issuedBy       User?     @relation("RequestIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt       DateTime? @map("issued_at")

  item    StoreItem @relation(fields: [itemId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])
  user    User      @relation(fields: [userId], references: [id])

  @@index([companyId, status])
  @@index([itemId])
  @@schema("finsync")
}

// ==========================================
// 11. RETAIL / SHOP MODELS
// ==========================================

model Customer {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  sales   Sale[]

  @@schema("finsync")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  purchases Purchase[]

  @@schema("finsync")
}

model Sale {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  customerId   Int?     @map("customer_id")
  registeredBy Int      @map("registered_by")
  totalAmount  Float
  discount     Float    @default(0)
  note         String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  company  Company    @relation(fields: [companyId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  user     User       @relation(fields: [registeredBy], references: [id])
  items    SaleItem[]

  @@schema("finsync")
}

model SaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int   @map("sale_id")
  itemId    Int   @map("item_id")
  quantity  Float
  unitPrice Float @map("unit_price")
  total     Float

  sale      Sale      @relation(fields: [saleId], references: [id])
  storeItem StoreItem @relation(fields: [itemId], references: [id])

  @@schema("finsync")
}

model Purchase {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  supplierId   Int?     @map("supplier_id")
  registeredBy Int      @map("registered_by")
  totalAmount  Float
  note         String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  projectId    Int?     @map("project_id")

  company  Company        @relation(fields: [companyId], references: [id])
  supplier Supplier?      @relation(fields: [supplierId], references: [id])
  user     User           @relation(fields: [registeredBy], references: [id])
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items    PurchaseItem[]

  @@schema("finsync")
}

model PurchaseItem {
  id         Int   @id @default(autoincrement())
  purchaseId Int   @map("purchase_id")
  itemId     Int   @map("item_id")
  quantity   Float
  unitCost   Float @map("unit_cost")
  total      Float

  purchase  Purchase  @relation(fields: [purchaseId], references: [id])
  storeItem StoreItem @relation(fields: [itemId], references: [id])

  @@schema("finsync")
}

// ==========================================
// 13. CHART OF ACCOUNTS & GENERAL LEDGER

model Account {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String
  name        String
  type        AccountType
  category    String?
  normalSide  AccountNormalSide @default(DEBIT)
  parentId    Int?              @map("parent_id")
  parent      Account?          @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Account[]         @relation("AccountHierarchy")
  isActive    Boolean           @default(true)
  description String?

  journalLines JournalLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@map("accounts")
  @@schema("finsync")
}

model JournalEntry {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entryNumber String
  date        DateTime @default(now())
  description String
  status      String   @default("DRAFT")
  sourceType  String?
  sourceId    Int?
  projectId   Int?     @map("project_id")
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  postedById Int?      @map("posted_by_id")
  postedBy   User?     @relation(fields: [postedById], references: [id], onDelete: SetNull)
  postedAt   DateTime?

  lines JournalLine[]

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  depreciationSchedules DepreciationSchedule[]

  @@unique([companyId, entryNumber])
  @@index([companyId, date])
  @@index([companyId, sourceType, sourceId])
  @@map("journal_entries")
  @@schema("finsync")
}

model JournalLine {
  id      Int          @id @default(autoincrement())
  entryId Int          @map("entry_id")
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId Int     @map("account_id")
  account   Account @relation(fields: [accountId], references: [id])

  description String?
  debit       Decimal @default(0) @db.Decimal(14, 2)
  credit      Decimal @default(0) @db.Decimal(14, 2)

  @@index([accountId])
  @@map("journal_lines")
  @@schema("finsync")
}

