// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  schemas  = ["finsync"]
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum SystemRole {
  Owner
  Cashier
  Sales
  Storekeeper
  OperatorDriver
  ProjectManager
  Foreman

  @@schema("finsync")
}

enum BudgetType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@schema("finsync")
}

model StoreCategory {
  id        Int      @id @default(autoincrement())
  name      String
  companyId Int      @map("company_id")
  createdAt DateTime @default(now())

  company Company     @relation(fields: [companyId], references: [id])
  items   StoreItem[]

  @@unique([name, companyId])
  @@schema("finsync")
}

enum StoreTxType {
  ISSUE
  RESTOCK
  RETURN

  @@schema("finsync")
}

enum MachineryStatus {
  IDLE
  WORKING
  MAINTENANCE

  @@schema("finsync")
}

enum EmploymentType {
  PERMANENT
  DAILY_LABORER

  @@schema("finsync")
}

enum MachineryOwnership {
  OWNED
  RENTED

  @@schema("finsync")
}

enum CompanyType {
  CONSTRUCTION
  RETAIL
  LOGISTICS
  AGRICULTURE
  MANUFACTURING
  SERVICE
  OTHER

  @@schema("finsync")
}

// ==========================================
// 2. USERS & COMPANIES
// ==========================================

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  phone     String?
  role      SystemRole @default(Owner)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  ownedCompanies      Company[]           @relation("CompanyOwner")
  companyMemberships  CompanyMember[]
  personalExpenses    PersonalExpense[]
  personalBudgets     PersonalBudget[]
  personalSavings     PersonalSaving[]
  registeredIncomes   CompanyIncome[]
  registeredExpenses  CompanyExpense[]
  storeTransactions   StoreTransaction[]
  machineryOps        MachineryOperator[]
  projectUpdates      ProjectUpdate[]
  notifications       Notification[]
  storeRequests       StoreRequest[]
  personalAccounts    PersonalAccount[]
  accountTransfers    AccountTransfer[]
  personalIncomes     PersonalIncome[]
  registeredSales     Sale[]
  registeredPurchases Purchase[]

  @@schema("finsync")
}

model PersonalAccount {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      PersonalExpense[]
  incomes       PersonalIncome[]
  transfersFrom AccountTransfer[] @relation("FromAccount")
  transfersTo   AccountTransfer[] @relation("ToAccount")

  @@schema("finsync")
}

model Company {
  id        Int         @id @default(autoincrement())
  name      String
  industry  String?
  type      CompanyType @default(OTHER)
  currency  String      @default("USD")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  ownerId           Int                @map("owner_id")
  owner             User               @relation("CompanyOwner", fields: [ownerId], references: [id])
  members           CompanyMember[]
  incomes           CompanyIncome[]
  expenses          CompanyExpense[]
  employees         Employee[]
  machineries       Machinery[]
  storeItems        StoreItem[]
  projects          Project[]
  storeTransactions StoreTransaction[]
  storeRequests     StoreRequest[]
  sales             Sale[]
  purchases         Purchase[]
  customers         Customer[]
  suppliers         Supplier[]
  storeCategories   StoreCategory[]

  @@schema("finsync")
}

model CompanyMember {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  companyId Int        @map("company_id")
  role      SystemRole

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@schema("finsync")
}

// ==========================================
// 3. PERSONAL FINANCE
// ==========================================

model PersonalBudget {
  id        Int        @id @default(autoincrement())
  userId    Int
  category  String
  amount    Float
  frequency BudgetType
  startDate DateTime   @default(now())
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model PersonalExpense {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  amount             Float
  category           String?
  note               String?
  date               DateTime @default(now())
  isCategorized      Boolean  @default(false)
  createdAt          DateTime @default(now())
  accountId          Int?
  isRecurring        Boolean  @default(false)
  recurringFrequency String?

  account PersonalAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user    User             @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model PersonalIncome {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float
  category  String
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  accountId Int?
  account   PersonalAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model PersonalSaving {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  name            String     @default("Savings Goal")
  targetAmount    Float      @map("target_amount")
  currentAmount   Float      @default(0) @map("current_amount")
  thresholdAmount Float      @map("threshold_amount")
  frequency       BudgetType
  startDate       DateTime   @map("start_date")
  createdAt       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model AccountTransfer {
  id            Int      @id @default(autoincrement())
  userId        Int
  fromAccountId Int
  toAccountId   Int
  amount        Float
  date          DateTime @default(now())
  note          String?

  fromAccount PersonalAccount @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   PersonalAccount @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("finsync")
}

// ==========================================
// 4. COMPANY FINANCE & STAFF
// ==========================================

model CompanyIncome {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  registeredBy Int      @map("registered_by")
  amount       Float
  category     String
  date         DateTime @default(now())
  note         String?
  projectId    Int?     @map("project_id")
  machineryId  Int?     @map("machinery_id")
  createdAt    DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  user      User       @relation(fields: [registeredBy], references: [id])
  machinery Machinery? @relation(fields: [machineryId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])

  @@schema("finsync")
}

model CompanyExpense {
  id                 Int      @id @default(autoincrement())
  companyId          Int      @map("company_id")
  registeredBy       Int      @map("registered_by")
  amount             Float
  category           String
  date               DateTime @default(now())
  note               String?
  projectId          Int?     @map("project_id")
  machineryId        Int?     @map("machinery_id")
  createdAt          DateTime @default(now())
  isRecurring        Boolean  @default(false)
  recurringFrequency String?

  company         Company        @relation(fields: [companyId], references: [id])
  user            User           @relation(fields: [registeredBy], references: [id])
  machinery       Machinery?     @relation(fields: [machineryId], references: [id])
  project         Project?       @relation(fields: [projectId], references: [id])
  unit            String?
  measuringUnit   MeasuringUnit? @relation(fields: [measuringUnitId], references: [id])
  measuringUnitId Int?

  @@schema("finsync")
}

model Employee {
  id             Int            @id @default(autoincrement())
  companyId      Int            @map("company_id")
  name           String
  employmentType EmploymentType @map("employment_type")
  wage           Float?
  nextPayDate    DateTime?      @map("next_pay_date")
  createdAt      DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@schema("finsync")
}

// ==========================================
// 5. MACHINERY & VEHICLES
// ==========================================

model Machinery {
  id                   Int                 @id @default(autoincrement())
  companyId            Int                 @map("company_id")
  name                 String
  category             String
  status               MachineryStatus     @default(IDLE)
  createdAt            DateTime            @default(now())
  company              Company             @relation(fields: [companyId], references: [id])
  operators            MachineryOperator[]
  expenses             CompanyExpense[]
  incomes              CompanyIncome[]
  ownershipType        MachineryOwnership  @default(OWNED)
  runningHours         Float               @default(0)
  lastMaintenanceHours Float               @default(0)
  projectId            Int?                @map("project_id")

  project Project? @relation(fields: [projectId], references: [id])

  @@schema("finsync")
}

model MachineryOperator {
  id          Int     @id @default(autoincrement())
  machineryId Int     @map("machinery_id")
  userId      Int     @map("user_id")
  isHelper    Boolean @default(false)

  machinery Machinery @relation(fields: [machineryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

// ==========================================
// 6. STORE & INVENTORY
// ==========================================

model StoreItem {
  id                Int      @id @default(autoincrement())
  companyId         Int      @map("company_id")
  name              String
  categoryId        Int      @map("category_id")
  quantity          Float    @default(0)
  lowStockThreshold Float    @default(5) @map("low_stock_threshold")
  sellingPrice      Float    @default(0) @map("selling_price")
  costPrice         Float    @default(0) @map("cost_price")
  createdAt         DateTime @default(now())
  unit              String   @default("pcs")

  company         Company            @relation(fields: [companyId], references: [id])
  category        StoreCategory      @relation(fields: [categoryId], references: [id])
  transactions    StoreTransaction[]
  storeRequests   StoreRequest[]
  measuringUnit   MeasuringUnit?     @relation(fields: [measuringUnitId], references: [id])
  measuringUnitId Int?
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]

  @@schema("finsync")
}

model StoreTransaction {
  id             Int         @id @default(autoincrement())
  itemId         Int         @map("item_id")
  companyId      Int         @map("company_id")
  type           StoreTxType
  quantity       Float
  issuedToUserId Int?        @map("issued_to_user_id")
  date           DateTime    @default(now())
  status         String      @default("APPROVED")
  createdAt      DateTime    @default(now())

  item    StoreItem @relation(fields: [itemId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])
  user    User?     @relation(fields: [issuedToUserId], references: [id])

  @@schema("finsync")
}

model StoreRequest {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  companyId Int      @map("company_id")
  userId    Int      @map("user_id")
  quantity  Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  item    StoreItem @relation(fields: [itemId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])
  user    User      @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

// ==========================================
// 7. PROJECTS & NOTIFICATIONS
// ==========================================

model Project {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  progress  Float    @default(0)
  createdAt DateTime @default(now())

  company   Company          @relation(fields: [companyId], references: [id])
  updates   ProjectUpdate[]
  expenses  CompanyExpense[]
  incomes   CompanyIncome[]
  machinery Machinery[]

  @@schema("finsync")
}

model ProjectUpdate {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  userId      Int      @map("user_id")
  note        String
  newProgress Float    @map("new_progress")
  date        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@schema("finsync")
}

model MeasuringUnit {
  id   Int    @id @default(autoincrement())
  name String

  storeItems      StoreItem[]
  companyExpenses CompanyExpense[]

  @@schema("finsync")
}

// ==========================================
// 8. RETAIL / SHOP MODELS
// ==========================================

model Customer {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  sales   Sale[]

  @@schema("finsync")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  purchases Purchase[]

  @@schema("finsync")
}

model Sale {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  customerId   Int?     @map("customer_id")
  registeredBy Int      @map("registered_by")
  totalAmount  Float
  discount     Float    @default(0)
  note         String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  company  Company    @relation(fields: [companyId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  user     User       @relation(fields: [registeredBy], references: [id])
  items    SaleItem[]

  @@schema("finsync")
}

model SaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int   @map("sale_id")
  itemId    Int   @map("item_id")
  quantity  Float
  unitPrice Float @map("unit_price")
  total     Float

  sale      Sale      @relation(fields: [saleId], references: [id])
  storeItem StoreItem @relation(fields: [itemId], references: [id])

  @@schema("finsync")
}

model Purchase {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  supplierId   Int?     @map("supplier_id")
  registeredBy Int      @map("registered_by")
  totalAmount  Float
  note         String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  company  Company        @relation(fields: [companyId], references: [id])
  supplier Supplier?      @relation(fields: [supplierId], references: [id])
  user     User           @relation(fields: [registeredBy], references: [id])
  items    PurchaseItem[]

  @@schema("finsync")
}

model PurchaseItem {
  id         Int   @id @default(autoincrement())
  purchaseId Int   @map("purchase_id")
  itemId     Int   @map("item_id")
  quantity   Float
  unitCost   Float @map("unit_cost")
  total      Float

  purchase  Purchase  @relation(fields: [purchaseId], references: [id])
  storeItem StoreItem @relation(fields: [itemId], references: [id])

  @@schema("finsync")
}
