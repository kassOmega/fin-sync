// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum SystemRole {
  Owner
  Cashier
  Sales
  Storekeeper
  OperatorDriver
  ProjectManager
  Foreman
}

enum BudgetType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ItemCategory {
  CONSUMABLE
  TOOL
}

enum StoreTxType {
  ISSUE
  RESTOCK
  RETURN
}

enum MachineryStatus {
  IDLE
  WORKING
  MAINTENANCE
}

enum EmploymentType {
  PERMANENT
  DAILY_LABORER
}

// ==========================================
// 2. USERS & COMPANIES
// ==========================================

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  phone     String?
  role      SystemRole @default(Owner)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  ownedCompanies     Company[]           @relation("CompanyOwner")
  companyMemberships CompanyMember[]
  personalExpenses   PersonalExpense[]
  personalBudgets    PersonalBudget[]
  personalSavings    PersonalSaving[]
  registeredIncomes  CompanyIncome[]
  registeredExpenses CompanyExpense[]
  storeTransactions  StoreTransaction[]
  machineryOps       MachineryOperator[]
  projectUpdates     ProjectUpdate[]
  notifications      Notification[]
  storeRequests      StoreRequest[]
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  industry  String?
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownerId           Int                @map("owner_id")
  owner             User               @relation("CompanyOwner", fields: [ownerId], references: [id])
  members           CompanyMember[]
  incomes           CompanyIncome[]
  expenses          CompanyExpense[]
  employees         Employee[]
  machineries       Machinery[]
  storeItems        StoreItem[]
  projects          Project[]
  storeTransactions StoreTransaction[]
  storeRequests     StoreRequest[]
}

model CompanyMember {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  companyId Int        @map("company_id")
  role      SystemRole

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
}

// ==========================================
// 3. PERSONAL FINANCE
// ==========================================

model PersonalBudget {
  id                Int        @id @default(autoincrement())
  userId            Int        @map("user_id")
  type              BudgetType
  amount            Float
  startDate         DateTime
  createdAt         DateTime   @default(now())
  carriedOverAmount Float      @default(0)

  user User @relation(fields: [userId], references: [id])
}

model PersonalExpense {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  amount        Float
  category      String?
  note          String?
  date          DateTime @default(now())
  isCategorized Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PersonalSaving {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  targetAmount    Float      @map("target_amount")
  currentAmount   Float      @default(0) @map("current_amount")
  thresholdAmount Float      @map("threshold_amount")
  frequency       BudgetType
  startDate       DateTime   @map("start_date")
  createdAt       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ==========================================
// 4. COMPANY FINANCE & STAFF
// ==========================================

model CompanyIncome {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  registeredBy Int      @map("registered_by")
  amount       Float
  category     String
  date         DateTime @default(now())
  note         String?
  projectId    Int?     @map("project_id")
  machineryId  Int?     @map("machinery_id")
  createdAt    DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  user      User       @relation(fields: [registeredBy], references: [id])
  machinery Machinery? @relation(fields: [machineryId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])
}

model CompanyExpense {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  registeredBy Int      @map("registered_by")
  amount       Float
  category     String
  date         DateTime @default(now())
  note         String?
  projectId    Int?     @map("project_id")
  machineryId  Int?     @map("machinery_id")
  createdAt    DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  user      User       @relation(fields: [registeredBy], references: [id])
  machinery Machinery? @relation(fields: [machineryId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])
}

model Employee {
  id             Int            @id @default(autoincrement())
  companyId      Int            @map("company_id")
  name           String
  employmentType EmploymentType @map("employment_type")
  wage           Float?
  nextPayDate    DateTime?      @map("next_pay_date")
  createdAt      DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

// ==========================================
// 5. MACHINERY & VEHICLES
// ==========================================

model Machinery {
  id                   Int                 @id @default(autoincrement())
  companyId            Int                 @map("company_id")
  name                 String
  category             String
  status               MachineryStatus     @default(IDLE)
  createdAt            DateTime            @default(now())
  company              Company             @relation(fields: [companyId], references: [id])
  operators            MachineryOperator[]
  expenses             CompanyExpense[]
  incomes              CompanyIncome[]
  runningHours         Float               @default(0)
  lastMaintenanceHours Float               @default(0)
  projectId            Int?                @map("project_id")

  project Project? @relation(fields: [projectId], references: [id])
}

model MachineryOperator {
  id          Int     @id @default(autoincrement())
  machineryId Int     @map("machinery_id")
  userId      Int     @map("user_id")
  isHelper    Boolean @default(false)

  machinery Machinery @relation(fields: [machineryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

// ==========================================
// 6. STORE & INVENTORY
// ==========================================

model StoreItem {
  id                Int          @id @default(autoincrement())
  companyId         Int          @map("company_id")
  name              String
  category          ItemCategory
  quantity          Float        @default(0)
  lowStockThreshold Float        @default(5) @map("low_stock_threshold")
  createdAt         DateTime     @default(now())
  unit              String       @default("pcs")

  company       Company            @relation(fields: [companyId], references: [id])
  transactions  StoreTransaction[]
  storeRequests StoreRequest[]
}

model StoreTransaction {
  id             Int         @id @default(autoincrement())
  itemId         Int         @map("item_id")
  companyId      Int         @map("company_id")
  type           StoreTxType
  quantity       Float
  issuedToUserId Int?        @map("issued_to_user_id")
  date           DateTime    @default(now())
  status         String      @default("APPROVED")
  createdAt      DateTime    @default(now())

  item    StoreItem @relation(fields: [itemId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])
  user    User?     @relation(fields: [issuedToUserId], references: [id])
}

model StoreRequest {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  companyId Int      @map("company_id")
  userId    Int      @map("user_id") // Who requested it
  quantity  Float
  status    String   @default("PENDING") // PENDING, APPROVED, ISSUED, REJECTED
  createdAt DateTime @default(now())

  item    StoreItem @relation(fields: [itemId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])
  user    User      @relation(fields: [userId], references: [id])
}

// ==========================================
// 7. PROJECTS & NOTIFICATIONS
// ==========================================

model Project {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  progress  Float    @default(0)
  createdAt DateTime @default(now())

  company   Company          @relation(fields: [companyId], references: [id])
  updates   ProjectUpdate[]
  expenses  CompanyExpense[]
  incomes   CompanyIncome[]
  machinery Machinery[]
}

model ProjectUpdate {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  userId      Int      @map("user_id")
  note        String
  newProgress Float    @map("new_progress")
  date        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
